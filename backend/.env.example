# For running the backend outside docker (npm run dev).
# With docker compose, configure the root .env instead.
NODE_ENV=development
PORT=4000
APP_REGION=us-east-1
ENFORCE_REGION=false

# Owner role (migrations/seed) and runtime role (RLS) against local compose DB.
DATABASE_URL=postgresql://nexus_owner:nexus_dev_password@localhost:5432/nexus?schema=public
APP_DATABASE_URL=postgresql://app_user:nexus_dev_app_password@localhost:5432/nexus?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=dev_only_jwt_secret_change_me_0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

FRONTEND_ORIGIN=http://localhost:3000
SEED_DEMO_DATA=true
