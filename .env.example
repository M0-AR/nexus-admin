# ──────────────────────────────────────────────────────────────────────────────
# Nexus Admin — environment configuration
# Copy to `.env` (docker compose reads it automatically) and change every value
# marked CHANGE_ME before running anywhere near production.
# ──────────────────────────────────────────────────────────────────────────────

# ── Platform ──────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=Nexus
# Region this deployment serves ({region}.yourdomain.com routing).
APP_REGION=us-east-1
# When true, the API rejects requests for tenants whose dataRegion differs from
# APP_REGION (run one stack per region behind geo-DNS; see README).
ENFORCE_REGION=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=nexus_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
POSTGRES_DB=nexus
POSTGRES_PORT=5432
# Password for the RLS-enforced runtime role (created by the init script).
APP_DB_PASSWORD=CHANGE_ME_app_password

# Connections are composed in docker-compose.yml from the values above; set
# these explicitly only for bare-metal/cloud deployments:
#   DATABASE_URL      → owner role, used for migrations & seeding
#   APP_DATABASE_URL  → app_user (NOBYPASSRLS), used at runtime
DATABASE_URL=postgresql://nexus_owner:CHANGE_ME_owner_password@postgres:5432/nexus?schema=public
APP_DATABASE_URL=postgresql://app_user:CHANGE_ME_app_password@postgres:5432/nexus?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# 32+ random bytes, hex or base64. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain — set to your apex domain in production (e.g. .example.com)
COOKIE_DOMAIN=
# Must be true in production (HTTPS only).
COOKIE_SECURE=false

# ── Crypto (BYOK envelope encryption) ─────────────────────────────────────────
# Master key: 64 hex chars (32 bytes). Generate: openssl rand -hex 32
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
FRONTEND_ORIGIN=http://localhost:3000
# Baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Nexus

# ── Demo data ─────────────────────────────────────────────────────────────────
# Seeds two demo tenants (acme / globex) on first boot when the DB is empty.
SEED_DEMO_DATA=true

# ── Ports (host side) ─────────────────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_PORT=3000
